{
  "name": "artura3d-challenge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db db-test",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @artura/api",
    "dev:api": "npm run dev -w @artura/api",
    "app:up": "docker compose up -d --build --wait api",
    "test": "tsc --noEmit && jest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
